   "id": "rev_by_region",
   "question": "What is total revenue by region?",
   "reference": [
    {
     "op": "load",
     "out": "o",
     "table": "orders"
    },
    {
     "op": "aggregate",
     "out": "r",
     "input": "o",
     "group_by": [
      "Region"
     ],
     "aggregations": [
      {
       "column": "Revenue",
       "func": "sum",
       "as_name": "Revenue"
      }
     ]
    }
   ],
